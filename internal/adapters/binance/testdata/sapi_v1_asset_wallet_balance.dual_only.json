{
  "source": "documented",
  "documentation": "https://developers.binance.com/en/docs/catalog/core-trading-wallet/api/rest-api/asset#query-user-wallet-balance",
  "notes": "The example's Spot wallet without assetBalances, which only needBalanceDetail=true returns, plus an Earn wallet valued at the open dual investment principal, 0.5 USDT.",
  "request": {
    "service": "spot",
    "method": "GET",
    "path": "/sapi/v1/asset/wallet/balance",
    "query": {
      "quoteAsset": "USDT"
    }
  },
  "status": 200,
  "body": [
    {
      "activate": true,
      "balance": "0",
      "walletName": "Spot"
    },
    {
      "activate": true,
      "balance": "0.5",
      "walletName": "Earn"
    }
  ]
}
