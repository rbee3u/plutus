# Copy to gitignored config/gotest.env for `go test`. Every variable here uses the PLUTUS_GOTEST_ prefix
# and is read only by tests (process environment wins). The `plutus` binary never reads this file.
#
# PLUTUS_GOTEST_DSN is a SERVER-level DSN: no database name after the slash. The MySQL user needs
# CREATE and DROP on `plutus_gotest_%`: each test package creates its own plutus_gotest_<unix>_<hex>
# database, migrates it, and drops it when the package finishes. Nothing has to be created by hand,
# and databases older than one hour left by killed runs are dropped on the next run.
# Optional hardening: a dedicated user with grants only on `plutus_gotest_%`.
#
#   CREATE USER 'plutus_gotest'@'%' IDENTIFIED BY '...';
#   GRANT ALL ON `plutus_gotest_%`.* TO 'plutus_gotest'@'%';
PLUTUS_GOTEST_DSN=user:password@tcp(127.0.0.1:3306)/

# Read-only Platform keys for `make test-live` (build tag `live`) and for `plutus adapter record`.
# Missing keys skip that Platform. Use the same key set as the test environment, never the prod set.
# PLUTUS_GOTEST_BINANCE_APIKEY=
# Use an HMAC secret or an unencrypted Ed25519 PKCS#8 PEM. For PEM, quote the value and write
# newlines as \n, for example: "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# PLUTUS_GOTEST_BINANCE_SECRET=
# PLUTUS_GOTEST_OKX_APIKEY=
# PLUTUS_GOTEST_OKX_SECRET=
# PLUTUS_GOTEST_OKX_PASSPHRASE=
# PLUTUS_GOTEST_BYBIT_APIKEY=
# PLUTUS_GOTEST_BYBIT_SECRET=
