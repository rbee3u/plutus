# Copy to gitignored config/test.env for `go test` integration tests.
# Process environment values win over this file. Do not point this DSN at
# plutus_local, plutus_agent, or plutus_walk.
#
# Create the database once:
#   CREATE DATABASE plutus_test;
PLUTUS_TEST_DATABASE_DSN=user:password@tcp(127.0.0.1:3306)/plutus_test
