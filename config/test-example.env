# Copy next to the deployed binary as test.env for the test environment on :8082 / database plutus_test.
# Do not reuse this master key in prod.env. The read-only Platform keys themselves are entered in the UI,
# never in this file.
#
# Create the database once on the remote MySQL server:
#   CREATE DATABASE plutus_test;
PLUTUS_DATABASE_DSN=user:password@tcp(127.0.0.1:3306)/plutus_test
# Generate a unique 32-byte key: openssl rand -base64 32
# PLUTUS_MASTER_KEY=
