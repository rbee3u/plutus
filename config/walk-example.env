# Copy to gitignored config/walk.env for human walkthrough on :8082 / database plutus_walk.
# Do not copy PLUTUS_MASTER_KEY from config/local.env or config/agent.env.
#
# Create the database once:
#   CREATE DATABASE plutus_walk;
PLUTUS_DATABASE_DSN=user:password@tcp(127.0.0.1:3306)/plutus_walk
# Generate a unique 32-byte key: openssl rand -base64 32
# PLUTUS_MASTER_KEY=
