# Copy to gitignored config/record.env for explicit `plutus adapter record` commands only.
# PLUTUS_RECORD_* process variables override this file. No fallback to gotest.env or runtime envs.
# Use read-only recording/test credentials, never prod. Ordinary tests do not read this file.
# Public interfaces, --list-requests and --dry-run need no keys.

PLUTUS_RECORD_BINANCE_APIKEY=
# HMAC secret or unencrypted Ed25519 PKCS#8 PEM. Quote PEM and escape newlines as \n:
# "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
PLUTUS_RECORD_BINANCE_SECRET=

PLUTUS_RECORD_OKX_APIKEY=
PLUTUS_RECORD_OKX_SECRET=
PLUTUS_RECORD_OKX_PASSPHRASE=

PLUTUS_RECORD_BYBIT_APIKEY=
PLUTUS_RECORD_BYBIT_SECRET=

# Kraken Spot and Futures are separate credential groups; fill only the group being recorded.
PLUTUS_RECORD_KRAKEN_SPOT_APIKEY=
PLUTUS_RECORD_KRAKEN_SPOT_SECRET=
PLUTUS_RECORD_KRAKEN_FUTURES_APIKEY=
PLUTUS_RECORD_KRAKEN_FUTURES_SECRET=
