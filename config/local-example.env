# Copy to gitignored config/local.env for local development on :8080 / database plutus_local.
# Process environment values win over this file. Do not reuse this master key
# in config/agent.env or config/walk.env.
#
# Create the database once:
#   CREATE DATABASE plutus_local;
# Integration tests use config/test.env and database plutus_test.
PLUTUS_DATABASE_DSN=user:password@tcp(127.0.0.1:3306)/plutus_local
# Generate a unique 32-byte key: openssl rand -base64 32
# PLUTUS_MASTER_KEY=
