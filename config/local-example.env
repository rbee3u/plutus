# Copy to gitignored config/local.env for the dev (local) environment on :8080 / database plutus_local.
# Process environment values win over this file. Do not reuse this master key in any other env file.
#
# Create the database once:
#   CREATE DATABASE plutus_local;
PLUTUS_DSN=user:password@tcp(127.0.0.1:3306)/plutus_local
# Generate a unique 32-byte key: openssl rand -base64 32
# PLUTUS_MASTER_KEY=
