# Copy to gitignored config/agent.env for the dev (agent) environment on :8081 / database plutus_agent.
# Do not copy PLUTUS_MASTER_KEY from any other env file.
#
# Create the database once:
#   CREATE DATABASE plutus_agent;
PLUTUS_DSN=user:password@tcp(127.0.0.1:3306)/plutus_agent
# Generate a unique 32-byte key: openssl rand -base64 32
# PLUTUS_MASTER_KEY=
