# Copy to gitignored config/agent.env for agent self-check on :8081 / database plutus_agent.
# Do not copy PLUTUS_MASTER_KEY from config/local.env or config/walk.env.
#
# Create the database once:
#   CREATE DATABASE plutus_agent;
PLUTUS_DATABASE_DSN=user:password@tcp(127.0.0.1:3306)/plutus_agent
# Generate a unique 32-byte key: openssl rand -base64 32
# PLUTUS_MASTER_KEY=
