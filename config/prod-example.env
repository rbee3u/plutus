# Copy next to the deployed binary as prod.env for the prod environment on :8083 / database plutus_prod.
# The database name must contain "prod" so `plutus db reset` refuses it. Use a master key that no other
# environment has, and back it up: it is the only way to read the stored platform credentials.
#
# Create the database once on the remote MySQL server:
#   CREATE DATABASE plutus_prod;
PLUTUS_DSN=user:password@tcp(127.0.0.1:3306)/plutus_prod
# Generate a unique 32-byte key: openssl rand -base64 32
# PLUTUS_MASTER_KEY=
